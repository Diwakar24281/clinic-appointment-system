# ===================================================================
# Clinic Appointment System - Environment Configuration Template
# ===================================================================
# Copy this file to '.env' in this directory and fill in your credentials.
# '.env' is automatically ignored by Git to protect your private keys.
#
# ===================================================================
# GMAIL SMTP CONFIGURATION (Required for Email OTP Verification)
# ===================================================================
# 1. Sign in to your Google Account (https://myaccount.google.com/).
# 2. Go to 'Security' and ensure '2-Step Verification' is turned ON.
# 3. Visit https://myaccount.google.com/apppasswords
#    (or search 'App passwords' in your Google Account).
# 4. Create a new App Password (e.g., App name: 'Clinic System').
# 5. Google will generate a 16-character password (e.g., 'abcd efgh ijkl mnop').
# 6. Paste your Gmail address and 16-character App Password below:
#    (Note: Do NOT use your regular personal Gmail password)

MAIL_USERNAME=yourclinic@gmail.com
MAIL_PASSWORD=your_16_character_app_password

# Optional SMTP Host & Port overrides (defaults to Gmail port 587 with STARTTLS)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587

# ===================================================================
# DATABASE CONFIGURATION (Optional - defaults to root/@Diwa24281 on localhost:3306)
# ===================================================================
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/clinic_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_mysql_password
